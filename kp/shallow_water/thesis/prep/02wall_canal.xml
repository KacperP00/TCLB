<?xml version="1.0"?>
<CLBConfig version="2.0" output="output/" permissive="true">
    <Geometry nx="3840" ny="352">
        <MRT>
            <Box/>
        </MRT>

        <WPressure name="Inlet">
            <Box dx="0" nx="1" dy="16" ny="320"/>
        </WPressure>

        <Wall>
            <Box dy="0" ny="16"/>
            <Box dy="336" ny="16"/>
        </Wall>

        <Wall>
            <Box dx="3808" nx="32"/>
        </Wall>

        <Obj2>
            <Box dx="500" nx="320" dy="16" ny="320"/>
        </Obj2>

        <Wall>
            <Box dx="1200" nx="32"/>
        </Wall>


    </Geometry>

    <Model>
        <Param name="Gravity" value="0.0002"/>
        <Param name="nu" value="0.0005"/>
        <Param name="Height" value="100.0"/>
        <Param name="InletVelocity" value="0"/>


        <Param name="Wave_A" value="0.099960"/>
        <Param name="Wave_k_real" value="0.019733"/>
        <Param name="Wave_k_imag" value="-0.000326"/>
        <Param name="Wave_w" value="0.002776"/>
        <Param name="Wave_Phase" value="1.560823"/>

        <Control Iterations="28000">
            <CSV file="kp/shallow_water/thesis/inlet_wave.csv" Time="iter">
                <Param name="Height" value="cos+100.0" zone="Inlet"/>
            </CSV>
        </Control>
    </Model>

    <VTK Iterations="50" what="BOUNDARY,Rho"/>
    <Log Iterations="50"/>

    <Solve Iterations="28000"/>

</CLBConfig>