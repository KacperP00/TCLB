<?xml version="1.0"?>
<CLBConfig version="2.0" output="mnt/c/TCLB/output/" permissive="true">
	<Geometry nx="2984" ny="964"> 
		<MRT>
			<Box/>
		</MRT>
		<DesignSpace>
			<Box dx="964" dy="2" nx="320" ny="960"/><!--whole rectangle topology-->
		</DesignSpace>
		<None mask="DESIGNSPACE">
			<Box dx="964" nx="320" ny="320" dy="322"/> <!--creating clean canal-->
		</None>
        <WPressure name="Inlet">
            <Box dx="1" nx="1"/>
        </WPressure>
		<Wall mask="ALL">
			<STL file="example/shallowwater/canal_geometry.stl" scale="20.0"/><!--importing canal geometry-->
		</Wall>
		<Obj1>
			<Box dx="1402" dy="322" nx="40" ny="320"/><!--place to check properties to optimize-->
		</Obj1>
	</Geometry>
	<Model>
		<Param name="Gravity" value=".0002"/>
		<Param name="nu" value="0.166666"/>
		<Param name="Height" value="100"/>
		<Param name="TotalDiffInObj" value="-1e6"/><!--weight to optimize for wave energy(?)-->
		<Param name="MaterialInObj" value="-0.001"/>

        <Control Iterations="25000">
            <CSV file="kp/shallow_water/topology_creation/topology_gen.csv" Time="iter">
                <Param name="Height" value="cos+100.0" zone="Inlet"/>
            </CSV>
        </Control>		
	</Model>

	<VTK Iterations="250" what="BOUNDARY,Rho"/>

	<InternalTopology/>
	<Optimize MaxEvaluations="20">
		<Adjoint NumberOfSnaps="14" type="unsteady">
			<Solve Iterations="25000"/>
		</Adjoint>
	</Optimize>
</CLBConfig>
